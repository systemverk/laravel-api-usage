{
    "name": "systemverk/laravel-api-usage",
    "description": "Self-hosted, actor-aware API usage analytics for Laravel. Track who uses your API, which endpoints they use, how much they use them, and how they perform.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "api",
        "usage",
        "analytics",
        "metrics",
        "multi-tenant",
        "redis",
        "telemetry"
    ],
    "authors": [
        {
            "name": "Eirik Halvorsen",
            "email": "eirik386@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/systemverk/laravel-api-usage/issues",
        "source": "https://github.com/systemverk/laravel-api-usage"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/redis": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "ext-redis": "Recommended Redis client for production throughput (alternative: predis/predis).",
        "predis/predis": "Pure PHP Redis client, usable when ext-redis is unavailable."
    },
    "autoload": {
        "psr-4": {
            "Systemverk\\LaravelApiUsage\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Systemverk\\LaravelApiUsage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "ci": [
            "@composer validate --strict",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Systemverk\\LaravelApiUsage\\ApiUsageServiceProvider"
            ],
            "aliases": {
                "ApiUsage": "Systemverk\\LaravelApiUsage\\Facades\\ApiUsage"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
